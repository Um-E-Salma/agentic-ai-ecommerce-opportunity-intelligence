# Backend API — Environment Variables
# Copy this file to .env and fill in the values you need.
# Lines beginning with # are comments.

# ── Server ──────────────────────────────────────────────
PORT=4000

# ── Platform Config ─────────────────────────────────────
BACKEND_PUBLIC_URL=http://localhost:4000

# ── Database ────────────────────────────────────────────
# SQLite file path relative to the backend-api directory
DATABASE_URL="file:./dev.db"

# ── Gemini AI ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Set to true to use mock AI responses (no API key required)
USE_MOCK_AI=true

# Allow fallback to mock data if Gemini call fails
ALLOW_MOCK_FALLBACK=true

# ── Telegram Notifications ──────────────────────────────
# Leave empty to skip Telegram — status will be TELEGRAM_NOT_CONFIGURED
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Email Notifications (Nodemailer / SMTP) ─────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email_here
SMTP_PASS=your_email_app_password_here
EMAIL_FROM=your_email_here
EMAIL_TO=your_email_here

# ── WhatsApp Mock Setup ─────────────────────────────────
WHATSAPP_MODE=mock
WHATSAPP_TEST_NUMBER=your_test_phone_number_here

# ── Support/contact display ─────────────────────────────
SUPPORT_PHONE_NUMBER=your_support_phone_number_here
SUPPORT_EMAIL=your_support_email_here

# ── Phase 4: Listing Optimization ───────────────────────
# No new env vars required for Phase 4

# ── Phase 5: Analytics & Campaign Strategy ──────────────
DEFAULT_ANALYSIS_WINDOW_DAYS=7
MIN_DAYS_FOR_ANALYSIS=3
STRONG_TREND_WINDOW_DAYS=14

# ── Phase 3: Platform Integrations ──────────────────────
LISTING_MODE=sandbox_or_mock

# ── eBay Sandbox / Future Extension ─────────────────────
EBAY_ENV=sandbox
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_REDIRECT_URI=your_ebay_redirect_uri_here

# ── Shopify Development Store ───────────────────────────
SHOPIFY_MODE=development
SHOPIFY_STORE_URL=your_shopify_store_url_here
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here
SHOPIFY_BOGUS_GATEWAY=true

# ── WooCommerce Test Store / Future Extension ───────────
WOOCOMMERCE_MODE=test
WOOCOMMERCE_STORE_URL=your_woocommerce_store_url_here
WOOCOMMERCE_CONSUMER_KEY=your_woocommerce_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=your_woocommerce_consumer_secret_here